#!/usr/bin/env python3
"""Stand-in for rb-scrobbler (github.com/Jeselnik/rb-scrobbler) used by the tests.

It NEVER talks to Last.fm. It copies the real tool's behaviour as read from its
source: batches of 50, "[OK]/[FAIL] Artist - Title" lines, a "Finished:" line,
and "-n delete-on-success" deleting the file only when nothing failed.

Behaviour is picked with FAKE_RB_MODE:
  ok           every play accepted (default)
  fail         every batch fails (offline / expired login look the same)
  partial:N    the first N requests (batches of 50) are accepted, later ones fail -
               counted across runs, like a network that drops part-way
  ignore       plays whose title contains IGNOREME are "ignored" by Last.fm
  hang         sleep for a long time (to test the timeout)
Every play the fake accepted is appended to FAKE_RB_RECORD (one JSON per line).
Like the real tool, it needs the Last.fm key in
$HOME/Library/Application Support/rb-scrobbler/rb-scrobbler.key.
"""
import json
import os
import sys
import time

args = sys.argv[1:]
mode = os.environ.get("FAKE_RB_MODE", "ok")
record = os.environ.get("FAKE_RB_RECORD")
key = os.path.join(os.environ["HOME"], "Library", "Application Support", "rb-scrobbler", "rb-scrobbler.key")

if "-auth" in args:
    os.makedirs(os.path.dirname(key), exist_ok=True)
    open(key, "w").write("fake-session-key\n")
    print("User successfully authenticated.")
if "-f" not in args:
    print("File (-f) cannot be empty!")
    sys.exit(1)
path = args[args.index("-f") + 1]
nmode = args[args.index("-n") + 1] if "-n" in args else ""
if not os.path.exists(key):
    print(time.strftime("%Y/%m/%d %H:%M:%S") + " open %s: no such file or directory" % key)
    sys.exit(1)
if mode == "hang":
    time.sleep(3600)

tracks = []
with open(path, encoding="utf-8") as fh:
    for line in fh:
        f = line.rstrip("\n").split("\t")
        if line.startswith("#") or len(f) < 7 or f[5] != "L":
            continue
        tracks.append(f)

counter = (record or os.path.join(os.path.dirname(path), "fake")) + ".requests"
ok = fail = 0
for b in range(0, len(tracks), 50):
    batch = tracks[b:b + 50]
    n = int(open(counter).read()) if os.path.exists(counter) else 0
    with open(counter, "w") as fh:
        fh.write(str(n + 1))
    batch_ok = mode == "ok" or mode == "ignore" or (mode.startswith("partial:") and n < int(mode.split(":")[1]))
    for f in batch:
        accepted = batch_ok and not (mode == "ignore" and "IGNOREME" in f[2])
        print("[%s] %s - %s" % ("OK" if accepted else "FAIL", f[0], f[2]))
        if accepted:
            ok += 1
            if record:
                with open(record, "a", encoding="utf-8") as fh:
                    fh.write(json.dumps({"artist": f[0], "title": f[2], "utc": f[6]}) + "\n")
        else:
            fail += 1
print("\nFinished: %d tracks scrobbled, %d failed, %d total" % (ok, fail, len(tracks)))
if nmode == "delete-on-success":
    if fail:
        print('Scrobble failures: "%s" not deleted.' % path)
        sys.exit(1)
    os.remove(path)
    print('"%s" deleted!' % path)
sys.exit(0)
